# Server
PORT=3000
NODE_ENV=development

# LNbits (Lightning payments)
# Use https://legend.lnbits.com to create a free wallet and get these keys
LNBITS_URL=https://legend.lnbits.com
LNBITS_ADMIN_KEY=your_lnbits_admin_key_here
LNBITS_INVOICE_KEY=your_lnbits_invoice_key_here

# Liquid testnet (Blockstream public API — no key required)
LIQUID_API_URL=https://blockstream.info/liquidtestnet/api

# App base URL (used for QR code generation)
APP_BASE_URL=http://localhost:3000

# Database path (SQLite)
DB_PATH=./coffee.db

# API authentication keys
# Leave unset (or empty) to run in dev mode with no auth required.
# Set all three to enable key-based auth on write endpoints.
ADMIN_KEY=your_admin_key_here
FOREMAN_KEY=your_foreman_key_here
WORKER_KEY=your_worker_key_here

# Provenance base URL (used for lot QR code SVG generation)
PROVENANCE_BASE_URL=http://134.122.8.237:3002
