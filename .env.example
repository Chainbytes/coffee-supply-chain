# Server
PORT=3000
NODE_ENV=development

# LNbits (Lightning payments)
# Use https://legend.lnbits.com to create a free wallet and get these keys
LNBITS_URL=https://legend.lnbits.com
LNBITS_ADMIN_KEY=your_lnbits_admin_key_here
LNBITS_INVOICE_KEY=your_lnbits_invoice_key_here

# Liquid testnet (Blockstream public API — no key required)
LIQUID_API_URL=https://blockstream.info/liquidtestnet/api

# App base URL (used for QR code generation)
APP_BASE_URL=http://localhost:3000

# Database path (SQLite)
DB_PATH=./coffee.db
